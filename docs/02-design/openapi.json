  "components": {
    "schemas": {
      "Decision": {
        "properties": {
          "store_id": {
            "type": "string",
            "pattern": "^S\\d{2}$",
            "title": "Store Id"
          },
          "item_id": {
            "type": "string",
            "pattern": "^I\\d{3}$",
            "title": "Item Id"
          },
          "order_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Order Date"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "override",
              "reject"
            ],
            "title": "Action"
          },
          "final_qty": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Final Qty"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 280
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "store_id",
          "item_id",
          "order_date",
          "action",
          "final_qty"
        ],
        "title": "Decision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
